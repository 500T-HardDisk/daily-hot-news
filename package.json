{
  "name": "news",
  "displayName": "每日热点新闻 · 真实版",
  "description": "内置每日热点新闻（18 个板块，纯文字，离线可读）：每板块 10 条公开 RSS 真实新闻，摘要 200–400 字并保留原文链接；另有 30 条真实热搜（合并最近 7 天）、历史保留、日期跳转、全球股市与黄金行情表。",
  "version": "1.7.13",
  "publisher": "500TSSD",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "news",
    "新闻",
    "新闻",
    "热点",
    "每日",
    "offline",
    "产品动态"
  ],
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0B2A6B",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/500T-HardDisk/daily-hot-news.git"
  },
  "bugs": {
    "url": "https://github.com/500T-HardDisk/daily-hot-news/issues"
  },
  "homepage": "https://github.com/500T-HardDisk/daily-hot-news#readme",
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:hotNews.sidebar",
    "onCommand:hotNews.selectDate",
    "onCommand:hotNews.selectCategory",
    "onCommand:hotNews.search",
    "onCommand:hotNews.refresh",
    "onCommand:hotNews.openDataFile",
    "onCommand:hotNews.about"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hotNews",
          "title": "热点新闻",
          "icon": "media/activity-icon.svg"
        }
      ]
    },
    "views": {
      "hotNews": [
        {
          "type": "webview",
          "id": "hotNews.sidebar",
          "name": "今日热点"
        }
      ]
    },
    "commands": [
      {
        "command": "hotNews.selectDate",
        "title": "跳转到指定日期",
        "category": "热点新闻",
        "icon": "$(calendar)"
      },
      {
        "command": "hotNews.selectCategory",
        "title": "选择新闻分类",
        "category": "热点新闻",
        "icon": "$(list-unordered)"
      },
      {
        "command": "hotNews.search",
        "title": "搜索热点新闻",
        "category": "热点新闻",
        "icon": "$(search)"
      },
      {
        "command": "hotNews.refresh",
        "title": "刷新新闻数据",
        "category": "热点新闻",
        "icon": "$(refresh)"
      },
      {
        "command": "hotNews.openDataFile",
        "title": "打开新闻数据文件",
        "category": "热点新闻",
        "icon": "$(json)"
      },
      {
        "command": "hotNews.about",
        "title": "关于与数据统计",
        "category": "热点新闻",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hotNews.refresh",
          "when": "view == hotNews.sidebar",
          "group": "navigation@1"
        },
        {
          "command": "hotNews.selectDate",
          "when": "view == hotNews.sidebar",
          "group": "navigation@3"
        },
        {
          "command": "hotNews.selectCategory",
          "when": "view == hotNews.sidebar",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "热点新闻",
      "properties": {
        "hotNews.defaultCategory": {
          "type": "string",
          "default": "all",
          "description": "打开视图时默认选中的分类 id（all 表示全部）。分类 id 见 news/index.json。"
        },
        "hotNews.summaryLines": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "maximum": 6,
          "description": "列表中每条新闻摘要显示的最大行数（0 表示不显示摘要）。"
        },
        "hotNews.localDataPath": {
          "type": "string",
          "default": "",
          "description": "可选的本地新闻数据目录（绝对路径或工作区相对路径）。留空则使用插件自带的 news 目录。维护新闻时可指向仓库中的 news 目录进行预览。"
        },
        "hotNews.showStatusBar": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏显示“热点 N”入口。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "news:new": "node scripts/new-day.mjs",
    "news:fetch": "node scripts/fetch-news.mjs",
    "news:validate": "node scripts/validate-news.mjs",
    "news:hotsearch": "node scripts/fetch-hotsearch.mjs",
    "news:freshness": "node scripts/check-freshness.mjs",
    "icon": "node scripts/make-icon.mjs",
    "test": "node scripts/validate-news.mjs --strict && node scripts/test-webview.mjs && node scripts/test-host.cjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "~1.85.0",
    "@vscode/vsce": "^2.32.0",
    "jsdom": "^30.1.3",
    "typescript": "^5.4.5"
  }
}
